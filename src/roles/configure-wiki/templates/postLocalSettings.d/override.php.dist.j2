/*
// This 4th method is the most flexible, useful for an organization where
// a different team manages the marketing collateral (logos, icons, favicons) 
// and they simply agree to use a naming convention for ACME Corp.
// Example: Use ACME Corp's logos if they exist but fall back to project-wide default.

// The function checks for files in this order: 1. Uploaded override via Special:Upload, 2. Wiki-specific custom file deployed from controller, 3. Project-wide default in web root. It is exactly the same as mezaGetLogoPath(), but adds the optional $customFilename parameter to allow for a different naming convention.

function mezaGetCustomLogoPath( $filename, $wikiId, $customFilename = null ) {
	$customFilename = $customFilename ?? $filename;

	// 1. Check for uploaded override (user-friendly upload via Special:Upload)
	// MediaWiki capitalizes first letter of uploaded files by default ($wgCapitalLinks)
	$uploadFilename = ucfirst( $filename );
	$hash = md5( $uploadFilename );
	$hashPath = substr( $hash, 0, 1 ) . '/' . substr( $hash, 0, 2 ) . '/' . $uploadFilename;
	$uploadedPath = "{{ m_uploads_dir }}/$wikiId/$hashPath";
	if ( file_exists( $uploadedPath ) ) {
		return "/$wikiId/img_auth.php/$hashPath";
	}

	// 2. Check for wiki-specific custom file (deployed from controller)
	// "{{ m_install_dir }}/.deploy-meza/public/wikis/$wikiId/$customFilename" is routable via 'config' symlink to the .deploy-meza public dir
	$wikiCustomPath = "{{ m_install_dir }}/.deploy-meza/public/wikis/$wikiId/$customFilename";
	if ( file_exists( $wikiCustomPath ) ) {
		return "/wikis/$wikiId/config/$customFilename";
	}

	// 3. Fall back to project-wide default in web root
	return "/$filename";
}

