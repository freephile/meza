---
# public.yml
#
# Config file for putting non-secure items needed for configuration during
# deploy of the application

# Production mode toggles opcache to ignore timestamps
# so live edits will NOT be seen without restarting the webserver or php-fpm.
# Production mode decreases opcache log verbosity to exclude warnings.
# Toggle this to 'false' for any development.
# The template defaults this to 'true' - including the case where it is ''
m_opcache_production_mode: {{ m_opcache_production_mode | default(true, true) }}

# Set a default authentication method for all wikis that don't specify one
# FIXME #763: List types, and descriptions
# meza_auth_type: "viewer-read"
meza_auth_type: "anon-read"

blender_landing_page_title: Test of Meza Wikis

## List of extension names to exclude (must match names in MezaCoreExtensions.yml exactly)
# m_excluded_extension_names:
#   - Wiretap
#   - CommentStreams
#   - Flow
#
# NOTES:
# - Extension names are case-sensitive and must match exactly as they appear in MezaCoreExtensions.yml
# - After modifying public.yml, run: sudo meza deploy <env>
# - This only prevents installation/loading; it doesn't remove already-installed extensions
# - To fully remove an extension, you may need to manually delete from /opt/meza/htdocs/mediawiki/extensions/
#
# Common extensions you might want to exclude:
# - Wiretap           # Page viewing statistics tracking
# - CommentStreams    # Commenting system (incompatible with some MediaWiki versions)
# - Flow              # Threaded discussions (requires Parsoid, can be complex)
# - DarkMode          # Dark mode toggle (if you don't need it)
# - WhoIsWatching     # Shows who is watching pages
# - WhosOnline        # Shows currently logged-in users
# - WatchAnalytics    # Analytics for watchlists
# - YouTube           # If you don't allow YouTube embeds



# Email senders
# Refs:
#   https://www.mediawiki.org/wiki/Manual:$wgPasswordSender
#   https://www.mediawiki.org/wiki/Manual:$wgEmergencyContact
wgPasswordSender: "admin@example.com"
# wgEmergencyContact = "another.email@example.com" # defaults to wgPassword Sender

