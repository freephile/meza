#!/bin/sh
set -euo pipefail
IFS=$'\n\t'

log() { echo "[$(date +'%F %T')] $*"; }

# Retry/backoff configuration: can be overridden by environment variables or Ansible template vars
# Environment override takes precedence; otherwise Ansible-provided defaults are used.
RETRY_MAX=${RETRY_MAX:-{{ elasticsearch_index_retry_max | default(5) }}}
RETRY_INITIAL=${RETRY_INITIAL:-{{ elasticsearch_index_retry_initial | default(5) }}}

# run_with_retries: execute a shell command (string) with retries and exponential backoff
run_with_retries() {
	local max_attempts=${RETRY_MAX}
	local delay=${RETRY_INITIAL}
	local attempt=1
	local cmd="$*"

	while [ $attempt -le $max_attempts ]; do
		log "Attempt $attempt/$max_attempts: $cmd"
		# Use sh -c to run the composed command string
		if sh -c "$cmd"; then
			log "Command succeeded"
			return 0
		else
			rc=$?
			log "Command failed with exit code $rc"
			if [ $attempt -lt $max_attempts ]; then
				log "Sleeping for ${delay}s before retry"
				sleep $delay
				delay=$((delay * 2))
			fi
		fi
		attempt=$((attempt + 1))
	done

	log "Command failed after $max_attempts attempts: $cmd"
	return 1
}

check_required_alias() {
	local alias_suffix="$1"
	local alias_name="wiki_${wiki_id}_${alias_suffix}"
	local alias_status
	local backing_indices
	local backing_index_count
	local backing_index

	alias_status=$(curl -s -o /dev/null -w '%{http_code}' "localhost:9200/_alias/$alias_name" 2>/dev/null || true)
	if [ "$alias_status" = "200" ]; then
		return 0
	fi

	# Check if a concrete index (not an alias) exists with the alias name.
	# CirrusSearch:UpdateSearchIndexConfig --startOver will fail with
	# "Primary index was expected to be an alias" when this is the case.
	# Since --startOver rebuilds from scratch, it is safe to delete it.
	concrete_index=$(curl --silent "localhost:9200/_cat/indices/$alias_name?h=index" 2>/dev/null | tr -d '[:space:]' || true)
	if [ "$concrete_index" = "$alias_name" ]; then
		log "Concrete index $alias_name exists where CirrusSearch expects an alias."
		log "Deleting it so --startOver can recreate it correctly as an alias."
		log "curl -s -XDELETE 'localhost:9200/$alias_name'"
		curl -s -XDELETE "localhost:9200/$alias_name" >/dev/null
		return 0
	fi

	backing_indices=$(curl --silent "localhost:9200/_cat/indices/${alias_name}*?h=index" 2>/dev/null | grep -vx "$alias_name" || true)
	backing_index_count=$(printf '%s\n' "$backing_indices" | sed '/^$/d' | wc -l | tr -d '[:space:]')

	if [ "$backing_index_count" -eq 1 ]; then
		backing_index=$(printf '%s\n' "$backing_indices" | sed '/^$/d')
		log "Primary alias $alias_name is missing; creating it for backing index $backing_index"
		log "curl -s -XPOST 'localhost:9200/_aliases' -H 'Content-Type: application/json' -d '{\"actions\":[{\"add\":{\"index\":\"$backing_index\",\"alias\":\"$alias_name\"}}]}'"
		curl -s -XPOST "localhost:9200/_aliases" -H 'Content-Type: application/json' -d "{\"actions\":[{\"add\":{\"index\":\"$backing_index\",\"alias\":\"$alias_name\"}}]}" >/dev/null
		return 0
	fi

	if [ "$backing_index_count" -eq 0 ]; then
		log "Primary alias $alias_name is missing, but no backing indices exist yet; continuing so CirrusSearch can create them."
		return 0
	fi

	log "Primary alias $alias_name is missing and could not be repaired automatically."
	log "Backing indices seen for $alias_name: ${backing_indices:-<none>}"
	log "If this is a failed rebuild, fix the alias manually and rerun the script."
	log "curl -s -XPOST 'localhost:9200/_aliases' -H 'Content-Type: application/json' -d '{\"actions\":[{\"add\":{\"index\":\"<backing-index>\",\"alias\":\"$alias_name\"}}]}'"
	return 1
}

echo "******* Generating Elasticsearch index for $wiki_id *******"

# Lock to prevent concurrent rebuilds for the same wiki
LOCKFILE="/var/lock/meza-elastic-build-${wiki_id}.lock"
if [ ! -w "$(dirname "$LOCKFILE")" ]; then
	LOCKFILE="/tmp/meza-elastic-build-${wiki_id}.lock"
fi
exec 200>"$LOCKFILE"
flock -n 200 || { echo "Another index build is running for $wiki_id; exiting."; exit 1; }
trap 'echo "Caught signal, releasing lock"; flock -u 200; rm -f "$LOCKFILE"; exit 1' INT TERM EXIT

# CirrusSearch expects both primary aliases to exist.
check_required_alias "general"
check_required_alias "content"

disable_search_file="{{ m_config_deploy_dir }}/public/wikis/$wiki_id/postLocalSettings.d/disable-search-update.php"

# Match CirrusSearch bootstrap guidance: disable live search updates while
# index config is recreated, then re-enable before ForceSearchIndex.
echo -e "<?php\n\$wgDisableSearchUpdate = true;\n" > "$disable_search_file"

# Run script to generate elasticsearch index mappings/config
cd "{{ m_mediawiki_install_path }}"
WIKI=$wiki_id {{ m_mediawiki_install_path | quote }}/maintenance/run CirrusSearch:UpdateSearchIndexConfig --startOver

# Re-enable search updates before bootstrapping content into Elasticsearch.
rm -f "$disable_search_file"

# Determine indices for this wiki (typical CirrusSearch index pattern)
index_pattern="wiki_${wiki_id}_*"
# Get indices; be tolerant if none exist yet
indices=$(curl --silent "localhost:9200/_cat/indices/$index_pattern?h=index" 2>/dev/null || true)

if [ -n "$indices" ]; then
	echo "Setting refresh_interval=-1 and number_of_replicas=0 for indices matching $index_pattern"
	for idx in $indices; do
		echo "  $idx"
		status=$(curl -s -o /dev/null -w '%{http_code}' -XPUT "localhost:9200/$idx/_settings" -H 'Content-Type: application/json' -d '{"index":{"refresh_interval":"-1","number_of_replicas":0}}' || true)
		if [ "$status" != "200" ]; then
			echo "  Warning: failed to update settings for $idx (HTTP $status)"
		fi
	done
else
	echo "No existing indices matching $index_pattern found; will create during indexing"
fi

# Bootstrap the search index (bulk indexing). These commands can take some time.
# We deliberately run with refresh disabled above for performance.
log "Starting ForceSearchIndex (skipLinks/indexOnSkip) with retries"
run_with_retries "WIKI=$wiki_id {{ m_mediawiki_install_path | quote }}/maintenance/run CirrusSearch:ForceSearchIndex --skipLinks --indexOnSkip"

# After first pass, recompute indices to include any newly-created indices so we can restore settings later
indices=$(curl --silent "localhost:9200/_cat/indices/$index_pattern?h=index" 2>/dev/null || true)

log "Starting ForceSearchIndex (skipParse) with retries"
run_with_retries "WIKI=$wiki_id {{ m_mediawiki_install_path | quote }}/maintenance/run CirrusSearch:ForceSearchIndex --skipParse"

# Some environments still enqueue cirrusSearchElasticaWrite jobs during rebuild.
# Drain them here so wrapper-driven rebuilds (for example create-wiki) finish
# with Elasticsearch populated before returning.
log "Draining queued cirrusSearchElasticaWrite jobs"
run_with_retries "WIKI=$wiki_id {{ m_mediawiki_install_path | quote }}/maintenance/run runJobs --type cirrusSearchElasticaWrite --maxjobs 10000"

# Recompute indices again to capture any additional indices created during indexing
indices=$(curl --silent "localhost:9200/_cat/indices/$index_pattern?h=index" 2>/dev/null || true)

# Restore index settings (refresh interval and replicas) so Elasticsearch can serve searches normally
if [ -n "$indices" ]; then
	echo "Restoring refresh_interval and number_of_replicas for indices matching $index_pattern"
	for idx in $indices; do
		echo "  $idx"
		status=$(curl -s -o /dev/null -w '%{http_code}' -XPUT "localhost:9200/$idx/_settings" -H 'Content-Type: application/json' -d '{"index":{"refresh_interval":"1s","number_of_replicas":1}}' || true)
		if [ "$status" != "200" ]; then
			echo "  Warning: failed to restore settings for $idx (HTTP $status)"
		fi
	done
	echo "Refreshing indices matching $index_pattern so document counts are visible before exit"
	refresh_status=$(curl -s -o /dev/null -w '%{http_code}' -XPOST "localhost:9200/$index_pattern/_refresh" || true)
	if [ "$refresh_status" != "200" ]; then
		echo "  Warning: failed to refresh indices for $index_pattern (HTTP $refresh_status)"
	fi
fi

echo "******* Elasticsearch build index complete! *******"

# Release lock and cleanup
flock -u 200 || true
rm -f "$LOCKFILE" || true
trap - INT TERM EXIT
