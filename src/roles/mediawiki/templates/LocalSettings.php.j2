 * Extensions defined in meza core and meza local yaml files, which are used to
 * load the extensions via Git or Composer, and which generate the PHP files
 * below.
 */

require_once "{{ m_config_deploy_dir }}/Extensions.php";


/**
 * Extension:CirrusSearch
 *
 * CirrusSearch cluster(s) are defined based upon Ansible hosts file and thus
 * cannot be easily added to MezaCoreExtensions.yml. As such, CirrusSearch config
 * is included directly in LocalSettings.php.j2
 */
$wgSearchType = 'CirrusSearch';
$wgCirrusSearchClusters['default'] = [];
{% for host in groups['elastic_servers'] %}
{% if host == inventory_hostname %}
$wgCirrusSearchClusters['default'] = [
	'host' => 'localhost',
	// 'username' => 'elastic',
	// 'password' => 'elasticsearch_password',
];

{% else %}
$wgCirrusSearchClusters['default'][] = '{{ host }}';
{% endif %}
{% endfor %}

$wgCirrusSearchWikimediaExtraPlugin['id_hash_mod_filter'] = true;

$wgHooks['SkinAddFooterLinks'][] = function ( Skin $skin, string $key, array &$footerlinks ) {
	if ( $key === 'places' ) {
		$footerlinks['test'] = Html::rawElement( 'a', [
			'href' => Title::newFromText(
				$skin->msg( 'Section 508 Compliance and Digital Accessibility' )->inContentLanguage()->text()
			)
		], $skin->msg( 'section508compliance' ) );
	}
};

/**
 * SECTION 9: LOAD POST LOCAL SETTINGS
 *
 * Items to override standard config.
 *
 * (1) Load all PHP files in postLocalSettings.d for all wikis
 * (2) Load all PHP files in postLocalSettings.d for this wiki
 */
foreach ( glob( "$m_config_deploy_dir/public/postLocalSettings.d/*.php" ) as $filename ) {
	require_once $filename;
}
foreach ( glob( "$m_config_deploy_dir/public/wikis/$wikiId/postLocalSettings.d/*.php" ) as $filename ) {
	require_once $filename;
}
