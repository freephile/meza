/**
 * Helper function to get logo path with fallback hierarchy:
 * 1. Check for uploaded file using MediaWiki's hashed upload directory. e.g. /opt/data-meza/uploads/wiki/4/47/Puncheon.png
 * 2. Check for wiki-specific file in .deploy-meza/public/wikis/$wikiId/
 * 3. Fall back to project-wide file in web root /
 *
 * Note: MediaWiki's $wgCapitalLinks defaults to true, so uploaded filenames
 * have their first letter capitalized (e.g., Meza-logo-135.png)
 */
function mezaGetLogoPath( $filename, $wikiId ) {
	// MediaWiki capitalizes first letter of uploaded files by default
	$uploadFilename = ucfirst( $filename );

	// Calculate MD5 hash for MediaWiki's upload directory structure
	$hash = md5( $uploadFilename );
	$hashPath = substr( $hash, 0, 1 ) . '/' . substr( $hash, 0, 2 ) . '/' . $uploadFilename;
	$uploadedPath = "{{ m_uploads_dir }}/$wikiId/$hashPath";

	// Check if uploaded file exists
	if ( file_exists( $uploadedPath ) ) {
		return "/$wikiId/img_auth.php/$hashPath";
	}

	// Check if wiki-specific file exists
	// "{{ m_install_dir }}/.deploy-meza/public/wikis/$wikiId/$filename" is routable via 'config' symlink to the .deploy-meza public dir
	$wikiSpecificPath = "{{ m_install_dir }}/.deploy-meza/public/wikis/$wikiId/$filename";
	if ( file_exists( $wikiSpecificPath ) ) {
		return "/wikis/$wikiId/config/$filename";
	}

	// Fall back to project-wide default in web root
	return "/$filename";
}

