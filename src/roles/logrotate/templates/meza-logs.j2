    compress
    delaycompress
    notifempty
    create {{ logrotate_apache_logs.create_mode }} {{ logrotate_apache_logs.create_owner }} {{ logrotate_apache_logs.create_group }}
    sharedscripts
    postrotate
{% if logrotate_apache_logs.postrotate_reload_apache %}
        # Reload Apache/httpd to release file handles
        systemctl reload httpd 2>/dev/null || systemctl reload apache2 2>/dev/null || true
{% endif %}
    endscript
}
{% endif %}

