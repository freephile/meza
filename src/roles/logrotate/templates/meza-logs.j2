{% endif %}

{% if logrotate_mediawiki_logs.enabled %}
# MediaWiki debug and application logs
{{ m_data_logs_dir }}/mediawiki/*.log {
    {{ logrotate_mediawiki_logs.frequency }}
    missingok
    rotate {{ logrotate_mediawiki_logs.rotate }}
    compress
    delaycompress
    notifempty
    create {{ logrotate_mediawiki_logs.create_mode }} {{ logrotate_mediawiki_logs.create_owner }} {{ logrotate_mediawiki_logs.create_group }}
    sharedscripts
    postrotate
        # Reload PHP-FPM to release file handles if it's running
        systemctl reload php-fpm 2>/dev/null || true
    endscript
}
{% endif %}

{% if logrotate_apache_logs.enabled %}
