# Meza log rotation configuration
# Deployed by Ansible - do not modify manually
# Generated on {{ ansible_date_time.date }} {{ ansible_date_time.time }}

# Note: Apache group guaranteed to exist due to bootstrap sequencing (Issue #287)
# getmeza.sh installs Apache before user setup, so {{ group_apache }} is always available

{% if logrotate_deploy_logs.enabled %}
# Deployment output logs - individual deployment sessions
{{ m_data_logs_dir }}/deploy-output/*.log {
    {{ logrotate_deploy_logs.frequency }}
    missingok
    rotate {{ logrotate_deploy_logs.rotate }}
    compress
    delaycompress
    notifempty
    create {{ logrotate_deploy_logs.create_mode }} {{ logrotate_deploy_logs.create_owner }} {{ logrotate_deploy_logs.create_group }}
    postrotate
        # Clean up very old deployment logs (older than {{ logrotate_deploy_logs.rotate * 2 }} days)
        find {{ m_data_logs_dir }}/deploy-output -name "*.log.*.gz" -mtime +{{ logrotate_deploy_logs.rotate * 2 }} -delete 2>/dev/null || true
    endscript
}
{% endif %}

{% if logrotate_main_deploy_log.enabled %}
# Main deployment log - ongoing deployment history
{{ m_data_logs_dir }}/deploy/deploy.log {
    {{ logrotate_main_deploy_log.frequency }}
    missingok
    rotate {{ logrotate_main_deploy_log.rotate }}
    compress
    delaycompress
    notifempty
    create {{ logrotate_main_deploy_log.create_mode }} {{ logrotate_main_deploy_log.create_owner }} {{ logrotate_main_deploy_log.create_group }}
}
{% endif %}

{% if logrotate_backup_logs.enabled %}
