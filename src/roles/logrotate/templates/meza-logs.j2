# Meza log rotation configuration
# Deployed by Ansible - do not modify manually
# Generated on {{ ansible_date_time.date }} {{ ansible_date_time.time }}

{% if logrotate_deploy_logs.enabled %}
# Deployment output logs - individual deployment sessions
{{ m_logs }}/deploy-output/*.log {
    {{ logrotate_deploy_logs.frequency }}
    missingok
    rotate {{ logrotate_deploy_logs.rotate }}
    compress
    delaycompress
    notifempty
{% if ansible_facts['getent_group'] is defined and group_apache in ansible_facts['getent_group'] %}
    create {{ logrotate_deploy_logs.create_mode }} {{ logrotate_deploy_logs.create_owner }} {{ logrotate_deploy_logs.create_group }}
{% else %}
    create {{ logrotate_deploy_logs.create_mode }} {{ logrotate_deploy_logs.create_owner }} root
{% endif %}
    postrotate
        # Clean up very old deployment logs (older than {{ logrotate_deploy_logs.rotate * 2 }} days)
        find {{ m_logs }}/deploy-output -name "*.log.*.gz" -mtime +{{ logrotate_deploy_logs.rotate * 2 }} -delete 2>/dev/null || true
    endscript
}
{% endif %}

